PUBLIC_SITE_URL=http://localhost:3001
INTERNAL_BACKEND_URL=http://localhost:3000
REDIRECT_RESOLVER_TIMEOUT_MS=1000
API_REQUEST_TIMEOUT_MS=8000
AUTH_LOGIN_PATH=/api/v1/auth/login
AUTH_REFRESH_PATH=/api/v1/auth/refresh
AUTH_LOGOUT_PATH=/api/v1/auth/logout
AUTH_REFRESH_TOKEN_FIELD=refreshToken
AUTH_ACCESS_COOKIE_NAME=hsp_access
AUTH_REFRESH_COOKIE_NAME=hsp_refresh
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=2592000
