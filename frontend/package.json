{
  "name": "hoang-su-phi-frontend",
  "version": "0.5.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --turbopack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "npx --yes bun@1.3.14 run scripts/test-all.ts",
