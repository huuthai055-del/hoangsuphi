    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.18",
    "@types/node": "22.15.30",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "eslint": "9.29.0",
    "eslint-config-next": "15.5.20",
    "postcss": "8.5.10",
    "tailwindcss": "4.1.18",
    "typescript": "5.8.3",
    "@eslint/eslintrc": "3.3.1",
    "@types/bun": "1.3.4"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "npm@10.9.2",
  "overrides": {
