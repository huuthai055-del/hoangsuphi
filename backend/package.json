{
  "name": "hoangsuphi-backend",
  "version": "1.0.0",
  "description": "Backend API for Hoang Su Phi Tourism Portal",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build ./src/index.ts --outdir ./dist --target bun",
    "start": "bun src/index.ts",
    "lint": "biome lint ./src",
    "format": "biome format --write ./src",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:search:check": "bun src/lib/database/search/run-fts-indexes.ts --check",
    "db:search:indexes": "bun src/lib/database/search/run-fts-indexes.ts --apply",
    "db:search:benchmark:seed": "bun src/modules/search/benchmark/run-search-benchmark.ts --seed",
    "db:search:benchmark": "bun src/modules/search/benchmark/run-search-benchmark.ts --run",
    "db:search:benchmark:smoke": "bun src/modules/search/benchmark/run-search-benchmark.ts --smoke",
    "db:search:prototype:apply": "bun src/modules/search/benchmark/run-search-benchmark.ts --prototype-apply",
    "db:search:prototype:write": "bun src/modules/search/benchmark/run-search-benchmark.ts --prototype-write",
    "db:search:prototype:smoke": "bun src/modules/search/benchmark/run-search-benchmark.ts --prototype-smoke",
    "db:search:prototype:benchmark": "bun src/modules/search/benchmark/run-search-benchmark.ts --prototype-run",
    "db:search:bounded:smoke": "bun src/modules/search/benchmark/run-search-benchmark.ts --bounded-smoke",
    "db:search:bounded:benchmark": "bun src/modules/search/benchmark/run-search-benchmark.ts --bounded-run",
    "db:search:per-entity:smoke": "bun src/modules/search/benchmark/run-search-benchmark.ts --per-entity-smoke",
    "db:search:per-entity:benchmark": "bun src/modules/search/benchmark/run-search-benchmark.ts --per-entity-run",
    "db:nearby:benchmark:seed": "bun src/modules/nearby/benchmark/run-nearby-benchmark.ts --seed",
    "db:nearby:benchmark": "bun src/modules/nearby/benchmark/run-nearby-benchmark.ts --run",
    "db:nearby:benchmark:cleanup": "bun src/modules/nearby/benchmark/run-nearby-benchmark.ts --cleanup",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun src/lib/database/seed.ts",
    "test": "bun test"
  },
  "dependencies": {
    "hono": "^4.4.12",
    "drizzle-orm": "^0.31.2",
    "postgres": "^3.4.4",
    "zod": "^3.23.8",
    "pino": "^9.2.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "^20.14.9",
    "typescript": "^5.5.2",
    "drizzle-kit": "^0.22.7",
    "@biomejs/biome": "1.8.3",
    "pino-pretty": "^11.2.1"
  }
}
