{
  "name": "hoangsuphi-backend",
  "version": "1.0.0",
  "description": "Backend API for Hoang Su Phi Tourism Portal",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build ./src/index.ts --outdir ./dist --target bun",
    "start": "bun src/index.ts",
    "lint": "biome lint ./src",
    "format": "biome format --write ./src",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun src/lib/database/seed.ts",
    "test": "bun test"
  },
  "dependencies": {
    "hono": "^4.4.12",
    "drizzle-orm": "^0.31.2",
    "postgres": "^3.4.4",
    "zod": "^3.23.8",
    "pino": "^9.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "typescript": "^5.5.2",
    "drizzle-kit": "^0.22.7",
    "@biomejs/biome": "1.8.3",
    "pino-pretty": "^11.2.1"
  }
}