# SERVER
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
API_VERSION=v1
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# DATABASE
DATABASE_URL=postgresql://hsp_user:hsp_password@localhost:5432/hsp_db
# Destructive Nearby benchmark commands require a dedicated database whose name ends in _benchmark.
NEARBY_BENCHMARK_DATABASE_URL=postgresql://hsp_user:hsp_password@localhost:5432/hsp_nearby_benchmark
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECT_TIMEOUT_MS=5000

# JWT
JWT_ACCESS_SECRET=CHANGE_ME_AT_LEAST_64_CHARS_RANDOM_STRING_HERE_DEVELOPMENT_ONLY_ACCESS_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_FROM_ACCESS_SECRET_64_CHARS_DEVELOPMENT_ONLY_REFRESH_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# SEARCH CURSOR (JSON keyring supports zero-downtime key rotation)
SEARCH_CURSOR_ACTIVE_KEY_ID=v1
SEARCH_CURSOR_KEYS_JSON={"v1":"CHANGE_ME_AT_LEAST_32_BYTES_RANDOM_SEARCH_CURSOR_SECRET"}

# RATE LIMITING
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_ANON_MAX=60
RATE_LIMIT_AUTH_MAX=300

# LOGGING
LOG_LEVEL=debug
LOG_PRETTY=true
